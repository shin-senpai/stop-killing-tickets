{
  "name": "stop-killing-tickets",
  "version": "0.1.0",
  "description": "Discord bot that bridges support tickets from many client servers to one hub server.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "debug": "4.4.3",
    "discord-html-transcripts": "3.3.0",
    "discord.js": "14.28.1",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
